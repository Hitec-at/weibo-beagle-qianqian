<view class="page">
  <view class="hero">
    <view class="hero-title">比格钱钱 · 微博检索</view>
    <view class="hero-text">{{notice}}</view>
    <view class="hero-text range">收录范围：{{rangeText}}</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="sort-row" style="margin-top: 28rpx;">
    <view
      wx:for="{{sorts}}"
      wx:key="value"
      class="chip {{sort === item.value ? 'active' : ''}}"
      data-sort="{{item.value}}"
      bindtap="changeSort"
    >{{item.label}}</view>
  </view>

  <view class="section-title">分类与专题</view>
  <view class="feed-grid">
    <view
      wx:for="{{feeds}}"
      wx:key="key"
      class="feed-card"
      data-item="{{item}}"
      bindtap="openFeed"
    >
      <view class="feed-card-title">{{item.title}}</view>
      <view class="muted">收录 {{item.count}} 条</view>
    </view>
  </view>

  <view class="sort-row" style="margin-top: 24rpx;">
    <view class="button" bindtap="openCategories">分类条目</view>
    <view class="button" bindtap="openSearch">搜索微博</view>
  </view>

  <view class="section-title">最新列表</view>
  <view wx:if="{{!loading && !posts.length}}" class="empty">暂无内容</view>
  <view
    wx:for="{{posts}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >
    <view class="card-head">
      <text>{{item.time_text}}</text>
      <text>{{item.retweeted_user ? '转发互动' : item.author}}</text>
    </view>
    <view class="excerpt">{{item.text}}{{item.truncated ? '…' : ''}}</view>
    <view wx:if="{{item.pics.length}}" class="thumbs">
      <image
        wx:for="{{item.pics}}"
        wx:for-item="pic"
        wx:for-index="picIndex"
        wx:key="thumb"
        class="thumb"
        mode="aspectFill"
        src="{{pic.thumb}}"
        data-index="{{picIndex}}"
        data-url="{{pic.url || pic.thumb}}"
        catchtap="previewImage"
      />
    </view>
    <view class="counts">
      赞 {{item.counts.likes}} · 转 {{item.counts.reposts}} · 评 {{item.counts.comments}}
    </view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:if="{{!hasMore && posts.length}}" class="empty">已经到底了</view>
</view>
