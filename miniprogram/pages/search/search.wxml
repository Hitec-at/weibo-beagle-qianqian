<view class="page">
  <view class="search-box">
    <input
      class="search-input"
      value="{{query}}"
      placeholder="搜索微博正文"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <button class="search-button" bindtap="onSearch">搜索</button>
  </view>

  <view class="sort-row" style="margin: 22rpx 0;">
    <view
      wx:for="{{sorts}}"
      wx:key="value"
      class="chip {{sort === item.value ? 'active' : ''}}"
      data-sort="{{item.value}}"
      bindtap="changeSort"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">搜索中…</view>
  <view wx:if="{{searched && !loading && !posts.length}}" class="empty">没有匹配结果</view>

  <view
    wx:for="{{posts}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >
    <view class="card-head">
      <text>{{item.time_text}}</text>
      <text>{{item.author}}</text>
    </view>
    <view class="excerpt">{{item.text}}{{item.truncated ? '…' : ''}}</view>
    <view class="counts">
      赞 {{item.counts.likes}} · 转 {{item.counts.reposts}} · 评 {{item.counts.comments}}
    </view>
  </view>
  <view wx:if="{{!hasMore && posts.length}}" class="empty">已经到底了</view>
</view>
