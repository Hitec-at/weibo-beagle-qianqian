page {
  background: #faf7f2;
  color: #2b2b2b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  padding: 28rpx 24rpx 64rpx;
}

.hero {
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #ece5db;
  border-radius: 24rpx;
}

.hero-title {
  color: #c2703d;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-text,
.muted {
  color: #8a8178;
  font-size: 24rpx;
  line-height: 1.7;
}

.range {
  margin-top: 12rpx;
  color: #5d554e;
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: #fff;
  border: 1rpx solid #ece5db;
  border-radius: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #8a8178;
  font-size: 23rpx;
}

.excerpt {
  margin: 18rpx 0;
  line-height: 1.7;
  white-space: pre-wrap;
}

.counts {
  color: #8a8178;
  font-size: 23rpx;
}

.thumbs {
  display: flex;
  gap: 10rpx;
  margin: 18rpx 0;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  background: #f3eee7;
}

.link {
  color: #c2703d;
  font-size: 25rpx;
}

.sort-row,
.feed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip,
.feed-card,
.button {
  border: 1rpx solid #ece5db;
  border-radius: 16rpx;
  background: #fff;
}

.chip {
  padding: 12rpx 22rpx;
  color: #8a8178;
  font-size: 24rpx;
}

.chip.active {
  color: #c2703d;
  border-color: #d79b72;
  background: #fbf3ea;
  font-weight: 600;
}

.feed-card {
  width: calc(50% - 7rpx);
  padding: 24rpx;
}

.feed-card-title {
  color: #c2703d;
  font-size: 30rpx;
  font-weight: 700;
}

.button {
  padding: 16rpx 24rpx;
  color: #c2703d;
  text-align: center;
}

.error {
  padding: 24rpx;
  color: #9b3c2f;
  background: #fff2ef;
  border-radius: 16rpx;
}

.empty {
  padding: 80rpx 20rpx;
  color: #8a8178;
  text-align: center;
}

.search-box {
  display: flex;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid #ece5db;
  border-radius: 16rpx;
}

.search-button {
  width: 130rpx;
  color: #fff;
  background: #c2703d;
  border: 0;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: calc(50% - 6rpx);
  overflow: hidden;
  background: #fff;
  border-radius: 18rpx;
}

.photo-image {
  width: 100%;
  height: 330rpx;
}

.photo-meta {
  display: block;
  padding: 14rpx;
  color: #8a8178;
  font-size: 22rpx;
}

.detail-text {
  padding: 24rpx;
  background: #fff;
  border-left: 6rpx solid #c2703d;
  border-radius: 16rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.video {
  width: 100%;
  margin: 20rpx 0;
  border-radius: 18rpx;
  background: #000;
}

.source-box {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fbf6ee;
  border: 1rpx dashed #e3d8ca;
  border-radius: 18rpx;
}

.footer {
  padding: 36rpx 8rpx 10rpx;
  color: #8a8178;
  font-size: 23rpx;
  line-height: 1.7;
}
