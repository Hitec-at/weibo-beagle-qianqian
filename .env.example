# ===== 微博站点 · 比格钱钱 配置模板 =====
# 复制为 .env 后填写。真实 .env 已加入 .gitignore，切勿提交或外发。

# 从已登录浏览器导出的微博 Cookie（见 docs/cookie-sop.md）
WEIBO_COOKIE=

# 目标账号
WEIBO_UID=3866429224
WEIBO_SCREEN_NAME=比格钱钱

# 反爬参数（按需微调，默认已足够保守）
RATE_MIN_SEC=4
RATE_MAX_SEC=8
PAGES_PER_BREAK=30
BREAK_MIN_SEC=120
BREAK_MAX_SEC=300
DAILY_MAX_REQUESTS=500

# 是否抓取长文全文（1=是，0=否）
FETCH_LONGTEXT=1
FETCH_PIC_INFO=1

# 公网默认关闭视频直链刷新；关闭时过期视频回退到原微博。
ENABLE_VIDEO_REFRESH=0

# 数据与原始 JSON
DB_PATH=data/weibo.db
SAVE_RAW=1

# 高清图筛选：转评总数（转+评）大于该值
PHOTO_MIN_ENGAGEMENT=200
